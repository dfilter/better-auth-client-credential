{
  "name": "better-auth-client-credential",
  "type": "module",
  "version": "0.1.1",
  "description": "A Better Auth plugin that implements the OAuth 2.0 client credentials flow against Microsoft Entra ID (formerly Azure AD)..",
  "author": "Dirk Filter <dirk_filter@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/dfilter/better-auth-client-credential#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfilter/better-auth-client-credential.git"
  },
  "bugs": {
    "url": "https://github.com/dfilter/better-auth-client-credential/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "better-auth",
    "better-fetch",
    "Microsoft",
    "Entra ID",
    "Client Credential"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@better-fetch/fetch": "^1.1.21",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "better-auth": "^1.5.6",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@better-fetch/fetch": "^1.1.21",
    "better-auth": "^1.5.6",
    "zod": "^4.3.6"
  }
}
